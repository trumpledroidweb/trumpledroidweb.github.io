{
  "backend": true,
  "api_base_url": "https://trumpledroid-api.cloudbeta28624.workers.dev",
  "roles": {
    "user": ["own"]
  },
  "collections": {
    "video_projects": {
      "fields": {
        "title": "string",
        "aspect_ratio": "string",
        "style": "string",
        "scenes_json": "string",
        "audio_track": "string",
        "duration": "number",
        "thumbnail": "string"
      },
      "operations": ["create", "read", "update", "delete"]
    }
  },
  "logic": {
    "total_video_duration": {
      "type": "calculation",
      "inputs": ["scene_durations_sum"],
      "formula": "scene_durations_sum"
    },
    "estimated_reading_time": {
      "type": "calculation",
      "inputs": ["word_count", "words_per_second"],
      "formula": "word_count / words_per_second"
    },
    "estimated_video_filesize_kb": {
      "type": "calculation",
      "inputs": ["bitrate_kbps", "duration_seconds"],
      "formula": "(bitrate_kbps * duration_seconds) / 8"
    }
  }
}